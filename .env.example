# Django
SECRET_KEY=replace-with-a-cryptographically-random-secret-at-least-50-characters
DEBUG=True
# Local files live in ./media; production must set an absolute path on a mounted durable filesystem.
MEDIA_ROOT=media
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
PORT=8000

# Database / PostGIS
# Optional managed PostgreSQL/PostGIS URL. Leave blank for local Docker;
# Django uses DB_* and Compose connects to its `db` service.
DATABASE_URL=
# Optional Compose-only managed service overrides. Leave blank to use db/redis service names.
COMPOSE_DATABASE_URL=
COMPOSE_CELERY_BROKER_URL=
COMPOSE_CELERY_RESULT_BACKEND=
COMPOSE_REDIS_URL=
DB_NAME=cafsule_db
DB_USER=cafsule
DB_PASSWORD=replace-with-a-unique-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable

# JWT signing secret. Changing this invalidates all existing JWTs.
JWT_SIGNING_KEY=replace-with-a-different-cryptographically-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@cafsule.com
FEEDBACK_RECIPIENT_EMAIL=codemaniac13@gmail.com
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24

# OAuth / Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Celery / Redis
# Host-run Django uses the local Redis instance on the machine.
# Docker Compose overrides these to redis://redis:6379/... inside the web container.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://localhost:6379/0
