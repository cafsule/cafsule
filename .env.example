# Django
SECRET_KEY=replace-with-a-cryptographically-random-secret-at-least-32-bytes
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
PORT=8000

# Database / PostGIS
# Prefer DATABASE_URL for managed PostgreSQL/PostGIS services (Neon, Render, etc.).
# When DATABASE_URL is absent, Django will build one from DB_* values.
# Use localhost/127.0.0.1 when running Django directly on the host.
# Docker Compose overrides DB_HOST to db for the web container.
DATABASE_URL=postgresql://cafsule:power1234@127.0.0.1:5432/cafsule_db?sslmode=disable
DB_NAME=cafsule_db
DB_USER=cafsule
DB_PASSWORD=power1234
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable

# JWT signing secret. Changing this invalidates all existing JWTs.
JWT_SIGNING_KEY=replace-with-a-different-cryptographically-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@cafsule-ims.com
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24

# OAuth / Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback/

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Celery / Redis
# Host-run Django uses the local Redis instance on the machine.
# Docker Compose overrides these to redis://redis:6379/... inside the web container.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://localhost:6379/0
